PINECONE_API_KEY=your-pinecone-api-key
GROQ_API_KEY=your-groq-api-key

# Set LLM_PROVIDER=anthropic and provide ANTHROPIC_API_KEY to use Anthropic.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
ANTHROPIC_API_KEY=your-anthropic-api-key

# These OCR settings are used only on the local tesseract-local branch.
TESSERACT_CMD=
TESSERACT_LANG=eng
